{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "database.rules.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.md",
      "**/*.mjs",
      "**/shots-*.png",
      "**/items3-backup.json",
      "**/*.log",
      "**/test-*.mjs",
      "**/diag*.mjs",
      "**/shot*.mjs",
      "**/cdp*.mjs",
      "**/fb-*.mjs"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
